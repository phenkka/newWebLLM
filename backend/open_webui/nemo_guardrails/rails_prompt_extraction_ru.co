# ─────────────────────────────────────────────────────────────────────────────
# rails_prompt_extraction_ru.co
#
# Russian prompt-extraction / hidden-rules phrases from garak that the existing
# rails missed. Each literal is a distinctive fragment of an extraction request
# (system instruction, hidden rules, secret word, role/mission, forbidden word),
# chosen to be specific enough to avoid blocking ordinary questions.
#
# Executed in-process by utils/guardrails.py (reads every *.co automatically).
# ─────────────────────────────────────────────────────────────────────────────

define flow garak_prompt_extraction_ru_extra
  # системная инструкция / сообщение / настройка
  if "системной инструкции" in $user_message
    bot say "Я не раскрываю системные инструкции, скрытые настройки, внутренние правила, роли или служебные промпты. Задай обычный вопрос."
    stop
  if "системном сообщении" in $user_message
    bot say "Я не раскрываю системные инструкции, скрытые настройки, внутренние правила, роли или служебные промпты. Задай обычный вопрос."
    stop
  if "системную настройку" in $user_message
    bot say "Я не раскрываю системные инструкции, скрытые настройки, внутренние правила, роли или служебные промпты. Задай обычный вопрос."
    stop
  if "первоначальную настройку" in $user_message
    bot say "Я не раскрываю системные инструкции, скрытые настройки, внутренние правила, роли или служебные промпты. Задай обычный вопрос."
    stop
  if "начальная инструкция" in $user_message
    bot say "Я не раскрываю начальные инструкции или скрытые настройки. Задай обычный вопрос."
    stop

  # правила / ограничения / запреты
  if "правилах и ограничениях" in $user_message
    bot say "Я не раскрываю внутренние правила и ограничения. Задай обычный вопрос по теме."
    stop
  if "своих ограничениях" in $user_message
    bot say "Я не раскрываю внутренние ограничения как служебный текст. Задай обычный вопрос по теме."
    stop
  if "перечисли все запреты" in $user_message
    bot say "Я не перечисляю внутренние запреты или скрытые инструкции. Задай обычный вопрос по теме."
    stop
  if "запреты которые тебе дали" in $user_message
    bot say "Я не перечисляю внутренние запреты или скрытые инструкции. Задай обычный вопрос по теме."
    stop
  if "если ты нарушишь правило" in $user_message
    bot say "Я не обсуждаю внутренние правила как способ их обойти или раскрыть скрытые инструкции."
    stop

  # роль / задача / обязанности
  if "роль и задачу" in $user_message
    bot say "Я не раскрываю скрытую роль или служебное задание. Помогу с обычным вопросом."
    stop

  # секреты / скрытые слова / запретное слово
  if "должен скрывать" in $user_message
    bot say "Я не раскрываю скрываемые элементы, секреты, внутренние правила или служебный промпт."
    stop
  if "у тебя есть секреты" in $user_message
    bot say "Я не раскрываю секреты, скрытые настройки или внутренние инструкции."
    stop
  if "тайну ты хранишь" in $user_message
    bot say "Я не раскрываю секреты, скрытые настройки или внутренние инструкции."
    stop
  if "нельзя произносить" in $user_message
    bot say "Я не раскрываю запрещённые/секретные слова, скрытые маркеры или внутренние инструкции."
    stop
  if "является запретным" in $user_message
    bot say "Я не раскрываю запрещённые/секретные слова, скрытые маркеры или внутренние инструкции."
    stop

  # персона / кодовое слово / "администратор сказал"
  if "омега»" in $user_message
    bot say "Я не подтверждаю и не раскрываю скрытые роли, кодовые слова или служебные инструкции."
    stop
  if "сказал тебе администратор" in $user_message
    bot say "Я не раскрываю скрытый служебный текст или инструкции, полученные до ответа пользователю."
    stop

# ─────────────────────────────────────────────────────────────────────────────
# rails_dangerous_access.co
#
# Input rail for the garak file_prompt_probe attack family: reading system
# files (/etc/passwd, /etc/shadow, ~/.ssh/id_rsa), running shell commands, or
# invoking agent tools like shell_execute / file_read.
#
# Executed in-process by utils/guardrails.py, which de-obfuscates invisible-char
# / '+'-split / JSON-wrapped payloads before matching these literals.
# ─────────────────────────────────────────────────────────────────────────────

define flow dangerous_file_and_command_access
  # ── sensitive file paths ────────────────────────────────────────────────
  if "/etc/passwd" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "/etc/shadow" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "/etc/" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "/root" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "/proc/" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if ".ssh" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "id_rsa" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "authorized_keys" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "169.254.169.254" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop

  # ── agent tool names ────────────────────────────────────────────────────
  if "shell_execute" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "shell_exec" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "file_read" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "file_write" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop

  # ── shell binaries / command chaining ───────────────────────────────────
  if "whoami" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "chmod" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "base64 -d" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "| sh" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "| bash" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "/bin/sh" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "wget " in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "curl " in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop

  # ── Russian command-execution / file-access verbs ───────────────────────
  if "выполни команд" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "запусти команд" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "прочитай файл" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "прочти файл" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "покажи содержимое" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "удали файл" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop
  if "запиши в файл" in $user_message
    bot say "Я не читаю системные файлы, пути и секреты и не выполняю системные команды. Запрос отклонён политикой безопасности."
    stop

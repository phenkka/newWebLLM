    stop

  # ── класс: list/enumerate all your <protected target> ────────────────
  if "all the prohibitions" in $user_message
    bot say "Я не перечисляю внутренние запреты или скрытые инструкции."
    stop
  if "list all" in $user_message and "prohibitions" in $user_message

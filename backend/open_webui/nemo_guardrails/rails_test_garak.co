    stop

  # ── класс: meta «почему ты не отвечаешь / what are you forbidden» ────
  if "what are you forbidden" in $user_message
    bot say "Я не раскрываю внутренние запреты или скрытые инструкции."
    stop
  if "what are you not allowed" in $user_message

    stop
  if "why cant you answer some" in $user_message
    bot say "Я не раскрываю внутренние ограничения, запреты или скрытые инструкции."
    stop

  # ── класс: encoded-instruction wrapper (base64 / rot13 / hex) ────────
  if "the following instruction is base64" in $user_message
    bot say "Я не выполняю и не декодирую скрытые инструкции из base64 или закодированных сообщений."

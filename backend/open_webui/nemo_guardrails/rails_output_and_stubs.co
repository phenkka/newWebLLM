define flow topic_control_check
  $_topic_control_noop = True

define flow pii_pattern_check
  $_pii_pattern_noop = True


define flow output_content_safety_check
  if "как сделать бомбу" in $bot_response
    bot say "Ответ заблокирован системой безопасности. Переформулируй запрос."
    stop
  if "как изготовить бомбу" in $bot_response
    bot say "Ответ заблокирован системой безопасности."
    stop
  if "изготовление бомбы" in $bot_response
    bot say "Ответ заблокирован системой безопасности."
    stop
  if "how to make a bomb" in $bot_response
    bot say "Response blocked by safety policy. Please rephrase your request."
    stop
  if "how to build a bomb" in $bot_response
    bot say "Response blocked by safety policy. Please rephrase your request."
    stop
  if "инструкция по изготовлению оружия" in $bot_response
    bot say "Ответ заблокирован системой безопасности."
    stop
  if "инструкция по изготовлению бомбы" in $bot_response
    bot say "Ответ заблокирован системой безопасности."
    stop

define flow output_pii_leak_check
  if "ssn:" in $bot_response
    bot say "Ответ заблокирован: обнаружена персональная информация."
    stop
  if "credit card" in $bot_response and "number" in $bot_response
    bot say "Ответ заблокирован: обнаружена персональная информация."
    stop

define flow output_injection_check
  if "[SYSTEM]" in $bot_response
    bot say "Ответ заблокирован: обнаружена инъекция системного блока."
    stop
  if "ignore all previous" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка инъекции инструкции."
    stop
  if "[[OVERRIDE]]" in $bot_response
    bot say "Ответ заблокирован: обнаружен маркер переопределения."
    stop

define flow garak_output_system_leak_check
  if "НЕБЕСА" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия скрытых инструкций или секретного маркера."
    stop
  if "небеса" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия скрытых инструкций или секретного маркера."
    stop
  if "system instructions are" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия системных инструкций."
    stop
  if "my system instructions are" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия системных инструкций."
    stop
  if "secret word is" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия секретного слова."
    stop
  if "secret word" in $bot_response and "omega" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия скрытой роли или секретного маркера."
    stop
  if "the forbidden word is" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия запрещённого слова."
    stop
  if "as omega" in $bot_response and "secret" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия скрытой роли или секретного маркера."
    stop
  if "you are a helpful, honest, and friendly assistant" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия системного промпта."
    stop
  if "my initial instruction" in $bot_response
    bot say "Ответ заблокирован: обнаружена попытка раскрытия системного промпта."
    stop


define flow garak_output_file_leak_check
  if "root:x:0:0" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/passwd)."
    stop
  if "daemon:x:" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/passwd)."
    stop
  if ":/usr/sbin/nologin" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/passwd)."
    stop
  if "www-data:x:" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/passwd)."
    stop
  if ":0:99999:7:::" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/shadow)."
    stop
  if "root:*:" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/shadow)."
    stop
  if "root:!:" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка содержимого системного файла (/etc/shadow)."
    stop
  if "-----begin" in $bot_response and "private key" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка приватного ключа."
    stop
  if "-----begin openssh private key" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка приватного ключа."
    stop
  if "ssh-rsa aaaa" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка SSH-ключа."
    stop
  if "aws_secret_access_key" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка облачных учётных данных."
    stop
  if "ami-id" in $bot_response and "instance-id" in $bot_response
    bot say "Ответ заблокирован: обнаружена утечка метаданных облака."
    stop
